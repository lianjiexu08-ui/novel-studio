// SQLite-compatible schema for local-first mode.
// Enums and Json columns from schema.postgresql.prisma are stored as String
// (JSON-serialized) here; enum values are lowercase domain values validated by
// packages/contracts. When moving to PostgreSQL, switch provider back and map
// the string columns to real enums/Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id
  title         String
  genre         String   @default("xuanhuan")
  /// Author covenant (CreativeCovenant JSON). Not story fact.
  covenant      String   @default("{}")
  stateRevision Int      @default(0)
  constraintRevision Int  @default(0)
  /// Structured WorldPack JSON; an empty object means it has not been generated yet.
  worldPack     String   @default("{}")
  /// Structured StoryBible JSON; an empty object means it has not been generated yet.
  storyBible     String   @default("{}")
  /// Immutable WorldPack/StoryBible snapshots, JSON array ordered by creation time.
  designHistory  String   @default("[]")
  /// Append-only CovenantRevision JSON array; keeps the author's original words.
  covenantHistory String  @default("[]")
  /// The approved PlanRevision driving briefs and generation.
  activePlanId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans         PlanRevision[]
  briefs        ChapterBrief[]

  chapters      Chapter[]
  candidates    ChapterCandidate[]
  events        StoryEvent[]
  relationships Relationship[]
  characters    Character[]
  worldRules    WorldRule[]
  plotNodes     PlotNode[]
  outboxEvents  OutboxEvent[]
  impacts       ImpactRecord[]
  runCheckpoints RunCheckpoint[]
  manuscripts   ManuscriptRevision[]
}

model Chapter {
  id               String           @id
  projectId        String
  number           Int
  currentVersionId String?
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         ChapterVersion[]
  candidates       ChapterCandidate[]

  @@unique([projectId, number])
}

/// Immutable book plan revision. Only status, reviews and approvedAt change after creation.
model PlanRevision {
  id                 String    @id
  projectId          String
  revision           Int
  parentId           String?
  status             String    // proposed | reviewed | approved | superseded
  source             String    // model | author | mixed
  note               String    @default("")
  plan               String    // JSON: BookPlan
  contentHash        String
  worldPackRevision  Int?
  storyBibleRevision Int?
  reviews            String    @default("[]") // JSON: PlanReview[], append-only
  createdAt          DateTime  @default(now())
  approvedAt         DateTime?
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revision])
}

/// Author-confirmed chapter brief; derived briefs are recomputed and not stored.
model ChapterBrief {
  id               String   @id
  projectId        String
  chapterNumber    Int
  planRevisionId   String
  status           String   // author_confirmed
  basisFingerprint String
  snapshot         String   // JSON: ChapterBrief
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, chapterNumber])
}

model RunCheckpoint {
  id            String   @id
  projectId     String
  targetChapter Int
  nextChapter   Int
  phase         String
  error         String?
  candidateIds  String   // JSON: Record<number, string>
  leaseToken    String?  // fencing token of the process allowed to commit
  leaseExpiresAt DateTime?
  control       String?  // pause | cancel, honoured at the next step boundary
  attempts      String   @default("{}") // JSON: Record<number, number>
  usage         String?  // JSON: RunUsage
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model ManuscriptRevision {
  id                  String   @id
  projectId           String
  revision            Int
  status              String
  chapterVersionIds   String   // JSON: string[]
  chapterCount        Int
  wordCount           Int      @default(0)
  targetWordCount     Int      @default(0)
  lengthCoverage      Float    @default(0)
  contentHash         String
  stateRevision       Int
  constraintRevision  Int
  worldPackRevision   Int
  storyBibleRevision  Int
  createdAt           DateTime @default(now())
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revision])
  @@index([projectId, status])
}

model ChapterVersion {
  id                String          @id
  chapterId         String
  revision          Int
  content           String
  status            String // adopted | superseded
  stale             Boolean         @default(false)
  parentVersionId   String?
  sourceCandidateId String?
  createdAt         DateTime        @default(now())
  chapter           Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  events            StoryEvent[]
  realizations      PlanRealization[]

  @@unique([chapterId, revision])
  @@index([chapterId, status, stale])
}

model ChapterCandidate {
  id                  String          @id
  projectId           String
  chapterId           String
  runId               String?
  content             String
  proposedEvents      String // JSON: EventDraft[]
  observedEvents      String? // JSON: EventDraft[]
  generatedAgainstRev Int
  generatedAgainstConstraintRev Int @default(0)
  // Null on rows written before design revisions were recorded; such candidates are stale once a design exists.
  generatedAgainstWorldPackRev  Int?
  generatedAgainstStoryBibleRev Int?
  contentHash         String?
  planRevisionId      String?         // approved plan active at generation time
  brief               String?         // JSON: ChapterBrief snapshot used for generation
  origin              String          @default("model") // model | demo
  usage               String?         // JSON: RunUsage
  status              String          @default("candidate") // candidate | adopted | rejected
  adoptedVersionId    String?
  createdAt           DateTime        @default(now())
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter             Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  checks              CheckExecution[]
  rulings             CheckRuling[]

  @@index([projectId, chapterId, status])
  @@index([runId, chapterId])
}

model CheckExecution {
  id           String           @id
  candidateId  String?
  checker      String
  status       String // passed | failed | inconclusive | unavailable
  message      String?
  stateRevision Int             @default(0)
  sequence     Int              @default(0) // order of executions within a candidate; rows are append-only
  policyVersion String?
  contentHash  String?          // candidate text the check looked at
  inputs       String?          // JSON: CheckInputs
  createdAt    DateTime         @default(now())
  candidate    ChapterCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, checker])
}

model CheckRuling {
  id          String           @id
  candidateId String
  checkId     String
  checker     String
  decision    String           // false_positive
  reason      String
  evidence    String
  createdAt   DateTime         @default(now())
  candidate   ChapterCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model StoryEvent {
  id               String         @id
  projectId        String
  chapterVersionId String
  chapterNumber    Int
  eventType        String
  subjectId        String
  predicate        String
  value            String // JSON
  storyTime        Int?
  evidence         String
  active           Boolean        @default(true)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterVersion   ChapterVersion @relation(fields: [chapterVersionId], references: [id], onDelete: Cascade)

  @@index([projectId, chapterNumber, active])
  @@index([subjectId, predicate, active])
}

model Character {
  id         String   @id
  projectId  String
  name       String
  aliases    String   @default("[]") // JSON: string[]
  role       String   @default("supporting") // protagonist | major | supporting | minor
  identity   String   @default("")
  goal       String   @default("")
  principles String   @default("")
  voice      String   @default("")
  notes      String   @default("")
  locked     Boolean  @default(false)
  canonicalId String? // Story Bible character this entry is the same person as
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model WorldRule {
  id        String   @id
  projectId String
  category  String // power | cost | resource | institution | geography | other
  title     String
  content   String   @default("")
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Relationship {
  id              String   @id
  projectId       String
  fromCharacterId String
  toCharacterId   String
  layer           String   @default("objective") // objective | belief
  kind            String
  value           String
  note            String   @default("")
  sinceChapter    Int?
  locked          Boolean  @default(false)
  lockPolicy      String?  // document_revision_locked | baseline_locked | event_change_forbidden | evolvable; null = derive from locked
  sourceEventId   String?
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromCharacterId, toCharacterId, kind, layer])
}

model PlotNode {
  id             String            @id
  projectId      String
  level          String            @default("chapter") // book | volume | chapter
  title          String
  expectedResult String
  targetChapter  Int?
  prerequisites  String // JSON: string[]
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  realization    PlanRealization?
}

model PlanRealization {
  id               String         @id
  plotNodeId       String         @unique
  chapterVersionId String?
  status           String         @default("unrealized") // unrealized | partial | realized | diverged | insufficient
  evidence         String?
  updatedAt        DateTime       @updatedAt
  plotNode         PlotNode       @relation(fields: [plotNodeId], references: [id], onDelete: Cascade)
  chapterVersion   ChapterVersion? @relation(fields: [chapterVersionId], references: [id])
}

model OutboxEvent {
  id          String    @id
  projectId   String
  dedupeKey   String    @unique
  kind        String
  aggregateId String
  payload     String // JSON
  publishedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([publishedAt, createdAt])
}

model ImpactRecord {
  id                    String   @id
  projectId             String
  changedChapterNumber  Int
  affectedChapterNumbers String // JSON: number[]
  reason                String
  createdAt             DateTime @default(now())
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
