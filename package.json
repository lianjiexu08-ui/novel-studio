{
  "name": "novel-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "novel-service-core"
  ],
  "scripts": {
    "pretest": "npm run generate -w novel-studio-persistence",
    "test": "node scripts/test-all.mjs",
    "model:milestone": "node scripts/run-model-milestone.mjs",
    "dev:api": "npm run start -w novel-studio-api",
    "dev:web": "npm run dev -w novel-studio-web",
    "typecheck:core": "tsc -p novel-service-core/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
