      "evidence": [
        {
          "sourceId": "story/characters/char_16",
          "quote": "\"name\": \"陆沉舟\""
        },
        {
          "sourceId": "story/characters/char_16",
          "quote": "保护已获救的弟弟免受程记报复"
        },
        {
          "sourceId": "story/characters/char_21",
          "quote": "\"name\": \"陆沉川\""
