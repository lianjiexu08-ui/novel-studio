  "checks": [
    {
      "criterion": "causality",
      "verdict": "revise",
      "explanation": "三卷的救援、疗程、南渡、失箱、仓火、北航、返乡训练和押运形成了依赖链，且百章只定位为阶段性收束，没有把九鼎或父案全貌提前结案。但前置报告保留了一个具体硬冲突：第33章将新租避火符按余纹核为约336小时，第40章又将同类新符按每张720小时计算；这会改变第33、40、42、43—50章的受护范围、换符节点、费用和行动条件，导致后续因果预算无法唯一推出。后续笼统通过结论没有给出统一规则，不能取消该返修。",
      "revisionAdvice": "统一第33章与第40章避火符的物品关系、满符容量、余纹验收口径、起算方式及连续佩戴/实际耗用规则；据此重算第33、40、42、43—50章的防护范围、换符时点、费用与余量，并确认每次外港行动都有明确的受护路径。"
    },
    {
      "criterion": "timeline",
      "verdict": "revise",
      "explanation": "前50章主要路线本身可以衔接：188日救援、190—209日疗程、212—216日陆路与实体海程、217—254日港口线及苏的并行返宗路线均有前置报告支持；51—100章尚属宏观安排，不因未逐章排日而判缺料。但336小时与720小时两种避火符口径会决定217—230日及231日后的防护是否过期，进而改变人物行动资格、换符和费用时序。现有通过报告未实际消除这一冲突。",
      "revisionAdvice": "先确定避火符真实有效时长及“连续佩戴/实际耗用”的计算方式，再逐日重列林辰自217日起的佩戴、换符、余量、受护区内外行程和费用，重点复核第33、40、42、43—50章；后续展开51—100章时分别落实各队出发、抵达、消息送达和支付日期。"
    },
    {
      "criterion": "payoff",
      "verdict": "pass",
      "explanation": "主要阶段承诺具备触发条件、兑现节点和代价：古境救援与押解、灵泉验源与配额、两剂疗程和复诊入账彼此区分；失箱、火因、父案、六号箱和九鼎线保留证据边界，没有把阶段性脱控或泉液取得重复消费为全案结局。首仓火具体责任仍未确认，但提案明确将其作为待查或有边界的未解线，而非虚称已经破案；这属于开放线归宿尚待后续明确，不否定当前阶段兑现。",
      "revisionAdvice": "后续必须继续区分已兑现的泉液、救援和有限脱控，与尚未兑现的父案、首仓火、六号箱及九鼎线；对首仓火明确最终查明结果，或明确不可查明时的证据边界，不能以宏观锚点替代归宿。"
    },
    {
      "criterion": "opening",
      "verdict": "pass",
      "explanation": "前50章冲突和选择具有递进：矿难与伤势、证物和有限同盟推进到生计与训练，再进入古境救援和疗程，随后转为护货失箱、仓火、扣工调查、追船及工人自主去留。第37章救人而放弃追携页、第44章以救援承受船损、第47章拒绝用改口换替船、第50章让吴卢当面作答，分别改变信息、资源、关系与代价；50章完成有限脱控但未清算火因、原账、父案或后续线。",
      "revisionAdvice": "第51—53章应承接脱控后的生计、交检和陆自述核验，不得重置为新的同型扣押救援，也不得提前兑现原账、火因或父案全貌。"
    },
    {
      "criterion": "pacing",
      "verdict": "pass",
      "explanation": "第33—50章的相邻段落持续改变目标、信息、关系或代价：货损取证、脱身失败、火场救人并放弃追页、撤回资源与潮路实测、追船和船损、安置分歧、拒绝改口以及受困者自主脱控各自承担不同功能。前置复核明确未发现连续用核账、问询或相同救援模板推进；51—100章的宏观节点也分别承担北航、黑舱救援、返乡先救谁、训练晋阶、押运和阶段收束功能，按当前范围无需提前补成逐章场景。",
      "revisionAdvice": ""
    },
    {
      "criterion": "genre",
      "verdict": "pass",
      "explanation": "玄幻要素实际改变行动和风险，而非仅作术语标签：凝元御物受距离、视线、重量、承力和真元支付限制；剑诀、元罡、伤势和余量限制战斗；虚海需要实体航程，验籍与地域权限限制跨陆；避火符只保护佩戴者而不保护货物；寿源必须完成疗程和复诊后才能入账。阶段胜利依靠站位、窗口、机关承力和职业代价，而非免费升级或万能法宝。",
      "revisionAdvice": ""
    },
    {
      "criterion": "growth",
      "verdict": "revise",
      "explanation": "主角的近期成长目标和选择路径很清楚：先辨伤情与引气，再分段贯脉、支付三元载晋入凝元，经过木块和导刃训练取得实测资格，随后用有限御物和剑诀完成救援与护货；代价包括三年寿元、赔偿、伤势和行动权限。可是第20章能力兑现依赖第18章后的真元余量，而当前同一提案又写180日晚仅半成、184日十成，导致“下一步能稳定施术”的资源前置不闭合。成长方向可保留，但近期回报的支付条件必须先修正。",
      "revisionAdvice": "保留“伤后训练—凝元—实测—受限救援”的成长链，补足或改写180—184日恢复账，并据修正后的余量重新核对第20—21章的剑诀、御物和后续训练；明确读者在该阶段能观察到的稳定能力，不以宏观规则说明代替实际支付和复测。"
    }
