    {
      "requestKey": "design76-power-followup-cycle-count",
      "runId": "design_run_77e97b37-cbf2-40be-ab17-2de79839c297",
      "stageId": "followup-batch-2/tiers",
      "criterion": "tiers",
      "expectedInputHash": "9583e5f14c6e7450196b6d93dd76ffa0294d39d675865e36d2920aa9ed446ded",
      "expectedCheckHash": "d3a848c58c73fc3bd13553938ee4d019c96ec2af460cf3c66a88902eb528586b",
      "claimQuote": "330日至397日的两个有效周期",
      "explanation": "330日是授课及行前许可，331—397日整个训练安排有六个有效十日周期，不是两个：331—340、341—350为第一段两周期；358—367、368—377为第二段两周期；378—387、388—397为第三段两周期，共60日。351—354失败周期报废一枚、不计有效，355—357停训；总计七枚实际耗材。原解释前句的六周期门槛与原文一致，但后句“两个”误将每段数量写成全程数量。保留原局部pass及解除声明；不能据此缩减训练、提前支付十元载或把勘误当成新的全局资格验收。",
      "evidence": [
        {
          "sourceId": "plan/milestones/ms_v3_training",
          "quote": "331–340为有效1、341–350为有效2。"
        },
        {
          "sourceId": "plan/milestones/ms_v3_training",
          "quote": "358–367有效3、368–377有效4、378–387有效5、388–397有效6，分别开第四至七枚。"
        },
        {
          "sourceId": "plan/milestones/ms_v3_training",
          "quote": "六个有效周期60日，加失败4日，实耗七枚；398日完整静置一日，399–414日只做复诊、稳定观察和获准的空载复测。"
        },
        {
          "sourceId": "plan/milestones/ms_v3_training",
          "quote": "378开始前顾同样借页讲第三段，复述和医修许可都通过后才做378–387、388–397两个有效周期。"
        }
      ],
