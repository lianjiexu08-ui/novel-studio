  "ruleSources": {
    "world/techniques/tech_10": {
      "id": "tech_10",
      "name": "乾坤逆命真解",
      "kind": "secret",
      "tier": "天阶",
      "allowedRealmIds": [
        "realm_04",
        "realm_05",
        "realm_06"
      ],
      "effect": "强行引燃十年至三十年阳寿，瞬间将自身攻伐与恢复威能暴涨三倍。",
      "cost": "永久耗损自身寿元，不可逆转，施术后衰老呈现白发。",
      "limitations": [
        "不可在寿元不足十年时强行催动",
        "每三十日内仅能施展一次否则命格碎裂"
      ],
      "counters": [
        "因果封绝印阻截命气流转",
